# DAYSTACK — Environment Variables
# Copy this file to .env and fill in the values.

# ── Gemini AI (AI Coach feature) ───────────────────────────────
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ── Server ─────────────────────────────────────────────────────
# Port to run the server on (default: 3000)
PORT=3000

# ── Authentication (REQUIRED for admin) ───────────────────────
# Secret for signing JWT tokens. Auto-generated if not set, but set this for stability.
JWT_SECRET="generate_a_64_char_random_hex_string_here"

# Admin account credentials (REQUIRED to enable admin login)
ADMIN_EMAIL="umakanthreddyannem2007@gmail.com"
ADMIN_PASSWORD="YOUR_ADMIN_PASSWORD_HERE"

# ── OTP Email (OPTIONAL — console fallback if not set) ─────────
# If not configured, OTP codes are printed to the server terminal (dev mode).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="DAYSTACK <your-email@gmail.com>"

# ── Google OAuth (OPTIONAL) ────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/
# Authorized redirect URI: http://YOUR_SERVER_URL/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── App URL (used for OAuth callback URL) ─────────────────────
APP_URL="http://localhost:3000"
